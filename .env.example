# Copy this file to .env (for local dev) and set the same values as
# repository secrets for the GitHub Actions build (see
# .github/workflows/deploy.yml).

# Production site URL, used for canonical URLs, Open Graph og:url, and
# structured data (src/lib/site-config.ts). Must match public/CNAME,
# public/sitemap.xml, and public/robots.txt.
VITE_SITE_URL=https://webcraftservices.online

# Formspree endpoint that receives inquiry form submissions
# (src/lib/submit-inquiry.ts). Create a form at https://formspree.io
# and paste its endpoint below, e.g. https://formspree.io/f/xxxxxxxx
VITE_FORMSPREE_ENDPOINT=
