# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real values.

# Formspree endpoint that delivers inquiry form submissions to your email.
# 1. Create a free account at https://formspree.io
# 2. Create a new form, set its notification email to where you want
#    inquiries delivered, and copy its endpoint URL.
# 3. Paste it below (it looks like https://formspree.io/f/xxxxxxxx).
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/your_form_id

# Your site's real production domain (no trailing slash). Used to build
# canonical URLs and Open Graph og:url tags at runtime.
# NOTE: index.html, public/sitemap.xml, and public/robots.txt are static
# files and can't read this variable — update the placeholder domain in
# those files too before deploying.
VITE_SITE_URL=https://your-domain-here.com
